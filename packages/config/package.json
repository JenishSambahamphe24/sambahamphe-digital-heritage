{
  "name": "@repo/config",
  "private": true,
  "type": "module",
  "exports": {
    "./eslint/base": "./eslint/base.js",
    "./eslint/node": "./eslint/node.js",
    "./eslint/api": "./eslint/api.js",
    "./prettier/base": "./prettier/base.js",
    "./prettier/node": "./prettier/node.js",
    "./prettier/api": "./prettier/api.js",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/node.json": "./tsconfig/node.json"
  },
  "scripts": {
    "lint": "eslint .",
