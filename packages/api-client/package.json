{
  "name": "@repo/api-client",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openapi.json"
  ],
  "scripts": {
    "build": "pnpm generate && tsc -p tsconfig.build.json",
    "dev": "pnpm generate && tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "pnpm generate && eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "prettier --write . && eslint --fix .",
    "typecheck": "pnpm generate && tsc --noEmit",
    "test": "pnpm generate && vitest run",
    "generate": "openapi-typescript openapi.json -o src/generated/openapi.ts"
  },
  "peerDependencies": {
    "openapi-fetch": "catalog:generic"
  },
  "devDependencies": {
    "@eslint/js": "catalog:generic",
    "@ianvs/prettier-plugin-sort-imports": "catalog:generic",
    "@repo/config": "workspace:*",
    "@types/node": "catalog:generic",
    "eslint": "catalog:generic",
    "globals": "catalog:generic",
    "openapi-fetch": "catalog:generic",
    "openapi-typescript": "catalog:generic",
    "prettier": "catalog:generic",
    "typescript": "catalog:generic",
    "typescript-eslint": "catalog:generic",
    "vite": "catalog:generic",
    "vitest": "catalog:generic"
  }
}
