    "@node-rs/argon2": "catalog:be",
    "@repo/contracts": "workspace:*",
    "bullmq": "catalog:be",
    "cookie-parser": "catalog:be",
    "drizzle-orm": "catalog:be",
    "ioredis": "catalog:be",
    "nestjs-pino": "catalog:be",
    "nodemailer": "catalog:be",
    "pg": "catalog:be",
    "pino": "catalog:be",
    "pino-http": "catalog:be",
